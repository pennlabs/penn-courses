{
  "name": "penn-courses-frontend",
  "workspaces": {
    "packages": [
      "shared-components",
      "alert",
      "plan",
      "review",
      "degree-plan"
    ],
    "nohoist": [
      "penncoursereview/react-scripts",
      "penncoursereview/react-scripts/**",
      "penncoursereview/eslint",
      "penncoursereview/eslint/**"
    ]
  },
  "private": true,
  "scripts": {
    "lint": "lerna run lint",
    "test": "echo no tests",
    "codecov": "echo no codecov"
  },
  "devDependencies": {
    "husky": "^4.2.5",
    "lerna": "^3.21.0",
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^2.10.0",
    "babel-eslint": "10.1.0",
    "eslint": "^6.8.0",
    "eslint-config-react-app": "^5.2.1",
    "eslint-plugin-react-hooks": "^1.6.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lerna run --concurrency 1 precommit"
    }
  },
  "dependencies": {
  },
  "resolutions": {
    "**/@types/react": "^18.2.0",
    "**/@types/react-dom": "^18.2.0"
  }
}
